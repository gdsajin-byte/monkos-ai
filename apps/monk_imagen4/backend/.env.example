# Cloudflare DNS 설정
# ============================================
#
# API 토큰 생성 방법:
# 1. https://dash.cloudflare.com/profile/api-tokens
# 2. "Create Token" 클릭
# 3. "Edit zone DNS" 템플릿 사용
# 4. Zone Resources: Include > Specific zone > monkos.ai
# 5. Continue to summary > Create Token
#
# Zone ID 확인 방법:
# 1. https://dash.cloudflare.com/
# 2. monkos.ai 도메인 클릭
# 3. Overview 탭 > 오른쪽 하단 "Zone ID" 복사
#
# ============================================

# Cloudflare API 토큰 (DNS 편집 권한 필요)
CLOUDFLARE_API_TOKEN=your_api_token_here

# monkos.ai 도메인의 Zone ID
CLOUDFLARE_ZONE_ID=your_zone_id_here
