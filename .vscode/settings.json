{
  // ─── 에디터 기본 ───
  "editor.fontSize": 14,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.formatOnSave": true,
  "editor.formatOnPaste": false,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.minimap.enabled": false,
  "editor.wordWrap": "on",
  "editor.linkedEditing": true,

  // ─── 파일별 포맷터 ───
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.wordWrap": "on"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // ─── 파일 탐색기 ───
  "files.exclude": {
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/.git": true,
    "**/dist": true,
    "**/.next": true,
    "**/.wrangler": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.git/objects/**": true,
    "**/dist/**": true,
    "**/.next/**": true
  },
  "files.autoSave": "onFocusChange",

  // ─── 검색 ───
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.next": true,
    "**/package-lock.json": true
  },

  // ─── JavaScript (순수 JS 프로젝트) ───
  "javascript.updateImportsOnFileMove.enabled": "always",
  "javascript.suggest.autoImports": true,

  // ─── Git (안전 우선) ───
  "git.autofetch": false,
  "git.confirmSync": true,
  "git.enableSmartCommit": true,
  "git.openRepositoryInParentFolders": "always",

  // ─── 터미널 (맥 최적화) ───
  "terminal.integrated.commandRiskAssessment": true,
  "terminal.integrated.outputCompression": true,
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.fontFamily": "MesloLGS NF",
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.defaultLocation": "editor",
  "terminal.integrated.tabs.enabled": true,
  "terminal.integrated.tabs.location": "left",

  // ─── Prettier ───
  "prettier.semi": true,
  "prettier.singleQuote": true,
  "prettier.trailingComma": "es5",
  "prettier.printWidth": 100,

  // ─── ESLint ───
  "eslint.validate": ["javascript", "html"],

  // ─── 탐색기 (안전 모드) ───
  "explorer.confirmDelete": true,
  "explorer.confirmDragAndDrop": true,
  "explorer.compactFolders": false,

  // ─── UI ───
  "breadcrumbs.enabled": true,
  "window.zoomLevel": 0,
  "workbench.startupEditor": "none",

  // ─── Emmet (순수 HTML용) ───
  "emmet.includeLanguages": {
    "html": "html"
  },

  // ─── Tailwind CSS ───
  "tailwindCSS.includeLanguages": {
    "html": "html",
    "javascript": "javascript"
  },

  // ─── Markdown Preview (캔버스 디스플레이) ───
  "markdown.preview.scrollPreviewWithEditor": true,
  "markdown.preview.scrollEditorWithPreview": true,
  "markdown.preview.breaks": true,
  "markdown.preview.openMarkdownLinks": "inPreview",

  // ─── Simple Browser (HTML 라이브 프리뷰) ───
  // Cmd+Shift+P → "Simple Browser: Show" 로 에디터 탭에서 열기
  // Live Server 확장과 병행 사용

  // ─── 캔버스 레이아웃 ───
  // 좌 사이드: 쌍아 (Claude Code) — 채팅 + 터미널
  // 중앙 에디터: 코드/프리뷰/브라우저 (무한 분할 + 탭)
  // 우 사이드: 용아 (Gemini) & Explorer (스위치)
  "workbench.sideBar.location": "left",
  "workbench.panel.defaultLocation": "bottom",

  // ─── Claude 관련 ───
  "claudeCode.selectedModel": "opus[1m]",
  "claude.autoScroll": true,
  "workbench.editor.autoLockGroups": {
    "agentSessionsWelcomePage": true,
    "workbench.editorinputs.browser": true,
    "default": true,
    "workbench.editor.chatSession": true,
    "imagePreview.previewEditor": true,
    "mainThreadWebview-markdown.preview": true,
    "workbench.input.interactive": true,
    "vscode.videoPreview": true
  }
}
