# Windows Factory 환경 변수
# 실제 값으로 수정 후 .env로 저장

# Gemini API Key (Cloudflare Worker에 이미 설정됨)
# 이미지 생성 스크립트는 Worker 엔드포인트를 사용하므로 로컬에 불필요
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Discord Webhook (보고용 - 선택)
DISCORD_WEBHOOK=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_TOKEN

# GCS 인증 (선택)
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json

# ComfyUI 경로 (설치 후)
COMFYUI_PATH=C:\ComfyUI

# 작업 간격 (초)
GIT_SYNC_INTERVAL=300
REPORT_INTERVAL=3600
