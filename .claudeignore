# MONK.kr Claude Code Ignore
# AI 인덱싱에서 제외할 파일 (코드 분석 불필요)

# Node.js (재생성 가능)
node_modules/
npm-debug.log*
package-lock.json

# Build outputs
dist/
build/
.cache/
*.min.js
*.min.css

# 이미지 (AI 코드 분석 시 불필요)
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.svg
*.ico
*.JPG

# 문서/바이너리 (마케팅/설명 자료)
*.pdf
*.docx
*.pptx

# 데이터베이스
*.db
*.sqlite
*.sqlite3

# OS Files
.DS_Store
Thumbs.db
*.icloud

# 임시 파일
*.tmp
*.temp
*.log
*.bak

# Cloudflare
.wrangler/

# Git 내부
.git/

# Python
__pycache__/
*.pyc
.venv*/

# 인증서 (보안)
*.pem
*.key

# 아카이브
_archive/
_backup/
