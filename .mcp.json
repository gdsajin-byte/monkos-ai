{
  "mcpServers": {
    "playwright": {
      "command": "bash",
      "args": [
        "scripts/tools/playwright_mcp.sh"
      ]
    },
    "google-analytics": {
      "command": "/Users/jeong-kyushin/.local/bin/uvx",
      "args": [
        "analytics-mcp"
      ],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "/Users/jeong-kyushin/.config/gcloud/adc_impersonated.json"
      }
    },
    "google-search-console": {
      "command": "npx",
      "args": [
        "-y",
