        "GOOGLE_APPLICATION_CREDENTIALS": "/Users/jeong-kyushin/.config/gcloud/adc_impersonated.json"
      }
    },
    "cloudflare": {
      "command": "bash",
      "args": [
        "scripts/tools/cloudflare_mcp.sh"
      ]
    },
    "google-docs": {
      "command": "bash",
      "args": [
