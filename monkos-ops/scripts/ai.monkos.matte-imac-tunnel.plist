<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- CF 터널 matte-imac 커넥터 + 외부 헬스 워처. ORDER_20261022 매팅_4060자리_Vision전환.
     레포 사본. 설치: monkos_AI/vision-matte/run_local.sh install.
     터널 토큰은 실행 때마다 CF API로 받아 env(TUNNEL_TOKEN)로만 넘긴다 — plist·파일·로그 미기록.
     워처: https://matte-imac.monkos.ai/health 60초 주기 2회 히트, 연속 2회 실패 → tg_notify 1줄(전이 때만·최소 10분 간격). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.monkos.matte-imac-tunnel</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/jeong-kyushin/.monkos/vision-matte/bin/tunnel.sh</string>
    <string>run</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>WorkingDirectory</key><string>/Users/jeong-kyushin/.monkos/vision-matte</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Users/jeong-kyushin/google-cloud-sdk/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>MONK_ROOT</key><string>/Users/jeong-kyushin/developer/monk_project</string>
  </dict>
  <key>StandardOutPath</key><string>/Users/jeong-kyushin/.monkos/vision-matte/launchd-tunnel.log</string>
  <key>StandardErrorPath</key><string>/Users/jeong-kyushin/.monkos/vision-matte/launchd-tunnel.log</string>
</dict>
</plist>
